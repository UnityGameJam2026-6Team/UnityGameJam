# 기본: git이 텍스트 파일을 자동 감지해 저장소에는 LF로 저장
* text=auto

# Unity YAML 에셋: 에디터가 LF로 저장하므로 작업 폴더에서도 LF 유지
*.unity              text eol=lf
*.prefab             text eol=lf
*.asset              text eol=lf
*.meta               text eol=lf
*.mat                text eol=lf
*.anim               text eol=lf
*.controller         text eol=lf
*.overrideController text eol=lf
*.mask               text eol=lf
*.playable           text eol=lf
*.physicMaterial     text eol=lf
*.physicsMaterial2D  text eol=lf
*.mixer              text eol=lf
*.spriteatlas        text eol=lf
*.spriteatlasv2      text eol=lf
*.preset             text eol=lf
*.lighting           text eol=lf
*.renderTexture      text eol=lf
*.terrainlayer       text eol=lf
*.shadervariants     text eol=lf
*.inputactions       text eol=lf
*.asmdef             text eol=lf
*.asmref             text eol=lf

# 코드·설정 텍스트
*.cs     text diff=csharp
*.shader text
*.hlsl   text
*.cginc  text
*.uss    text
*.uxml   text
*.json   text
*.md     text

# 바이너리: 줄바꿈 변환·텍스트 diff·자동 병합을 하지 않는다 (Git LFS는 쓰지 않음)
# 작업 원본(PSD 등)은 저장소 밖에 두고, 게임에 쓰는 내보낸 파일만 넣는다.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.psd        binary
*.tga        binary
*.gif        binary
*.exr        binary
*.hdr        binary
*.wav        binary
*.mp3        binary
*.ogg        binary
*.mp4        binary
*.ttf        binary
*.otf        binary
*.fbx        binary
*.skel       binary
*.skel.bytes binary
*.xlsx       binary
*.pdf        binary
*.dll        binary
*.so         binary
